{
  "name": "echotrace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @echotrace/web dev",
    "build": "pnpm --filter @echotrace/web build",
    "preview": "pnpm --filter @echotrace/web preview",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "content:check": "pnpm --filter @echotrace/engine content:check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm content:check && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "5.9.3"
  }
}
