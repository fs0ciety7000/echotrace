# Echo Trace — serveur statique. TLS est terminé par Coolify (Traefik) puis Cloudflare.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Fingerprinted assets: cache forever. Entry points: always revalidate.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @entry Cache-Control "no-cache"

	# handle blocks are mutually exclusive: /healthz is answered before the SPA rewrite can catch it.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		# SPA fallback.
		try_files {path} /index.html
		file_server
	}
}
